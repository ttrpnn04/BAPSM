<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BAP Stock</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BAPStockManagement.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var email = User.Identity?.Name ?? "";
        var initial = email.Length > 0 ? email[0].ToString().ToUpper() : "?";
        var isSignedIn = SignInManager.IsSignedIn(User);
        var isAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
    }

    <div class="app-shell">
        <!-- ── Sidebar ── -->
        <aside class="sidebar" id="sidebar">
            <a class="sb-brand" asp-controller="Home" asp-action="Index">
                <span class="sb-logo"><i class="bi bi-box-seam"></i></span>
                <span class="sb-brand-name">BAP Stock</span>
            </a>

            <nav class="sb-nav">
                <a class="sb-link" href="/Home/Index" data-match="/home,/">
                    <i class="bi bi-house"></i><span>หน้าแรก</span>
                </a>

                @if (isSignedIn)
                {
                    <div class="sb-section-label">สต็อก</div>

                    <a class="sb-link" href="/Stock/Index" data-match="/stock/index">
                        <i class="bi bi-box-seam"></i><span>สต็อกสินค้า</span>
                    </a>
                    <a class="sb-link" href="/Transactions/Index" data-match="/transactions/index">
                        <i class="bi bi-arrow-left-right"></i><span>ประวัติรายการ</span>
                    </a>
                    <a class="sb-link" href="/Stock/MonthlyReport" data-match="/stock/monthlyreport">
                        <i class="bi bi-bar-chart-line"></i><span>รายงานรายเดือน</span>
                    </a>
                    @if (isAdmin)
                    {
                        <a class="sb-link" href="/Categories/Index" data-match="/categories">
                            <i class="bi bi-folder2"></i><span>หมวดหมู่</span>
                        </a>
                        <a class="sb-link" href="/Import/Index" data-match="/import">
                            <i class="bi bi-file-earmark-arrow-up"></i><span>Import Excel</span>
                        </a>
                    }
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="sb-section-label">ระบบ</div>
                        <a class="sb-link" href="/Users/Index" data-match="/users">
                            <i class="bi bi-people"></i><span>ผู้ใช้งาน</span>
                        </a>
                    }
                }
            </nav>

            @if (isSignedIn)
            {
                <div class="sb-user">
                    <div class="sb-user-info">
                        <div class="sb-avatar">@initial</div>
                        <span class="sb-user-name">@email</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sb-logout">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>ออกจากระบบ</span>
                        </button>
                    </form>
                </div>
            }
        </aside>

        <!-- ── Main area ── -->
        <div class="app-main">
            <!-- Mobile topbar -->
            <div class="mobile-topbar">
                <button class="sb-toggle" id="sidebarToggle" aria-label="เปิดเมนู">
                    <i class="bi bi-list"></i>
                </button>
                <span class="mobile-topbar-brand">BAP Stock</span>
            </div>

            <main class="main-content">
                @await Html.PartialAsync("_FlashMessages")
                @RenderBody()
            </main>

            <footer style="padding:.75rem 1.5rem;font-size:.78rem;color:var(--text-3);border-top:1px solid var(--border-light);">
                &copy; 2026 BAP Stock Management
            </footer>
        </div>
    </div>

    <!-- Mobile sidebar overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
