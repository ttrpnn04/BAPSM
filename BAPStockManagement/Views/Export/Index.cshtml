@{
    ViewData["Title"] = "Export Excel";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="page-header">
    <div>
        <h1>Export Excel</h1>
        <p class="subtitle">ส่งออกรายงานรับเข้า ขายออก และยอดคงเหลือเป็นไฟล์ Excel</p>
    </div>
</div>

<div class="form-card mb-4">
    <form asp-controller="Transactions" asp-action="ExportDailyReport" method="get" class="row g-3">
        <div class="col-md-4">
            <label class="form-label">จากวันที่</label>
            <input type="date" name="fromDate" value="@today" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">ถึงวันที่</label>
            <input type="date" name="toDate" value="@today" class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
            </button>
        </div>
    </form>

    <div class="mt-3 small text-muted">
        ไฟล์ที่ได้จะมี 3 sheet: <code>รับเข้า</code>, <code>ขายออก</code>, และ <code>ยอดคงเหลือ</code>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="stat-card stat-success">
            <div>
                <div class="stat-label">Sheet รับเข้า</div>
                <div class="stat-sub">แสดงจำนวนรับเข้าแยกตามสินค้าและสี/รุ่น</div>
            </div>
            <div class="stat-icon"><i class="bi bi-arrow-down-circle"></i></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card stat-warning">
            <div>
                <div class="stat-label">Sheet ขายออก</div>
                <div class="stat-sub">แสดงจำนวนขายออกแยกตามสินค้าและสี/รุ่น</div>
            </div>
            <div class="stat-icon"><i class="bi bi-arrow-up-circle"></i></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card stat-primary">
            <div>
                <div class="stat-label">Sheet ยอดคงเหลือ</div>
                <div class="stat-sub">แสดงสต็อกรวมปัจจุบันทุกสินค้าและทุกสี</div>
            </div>
            <div class="stat-icon"><i class="bi bi-grid-3x3-gap"></i></div>
        </div>
    </div>
</div>
