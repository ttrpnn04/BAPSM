@model IEnumerable<BAPStockManagement.ViewModels.Categories.CategoryListItemViewModel>
@{
    ViewData["Title"] = "จัดการหมวดหมู่";
    var activeCount = Model.Count(c => c.IsActive);
    var inactiveCount = Model.Count(c => !c.IsActive);
}

<div class="page-header">
    <div>
        <h1>จัดการหมวดหมู่</h1>
        <p class="subtitle">จัดกลุ่มสินค้าและกำหนดชื่อคอลัมน์สี/รุ่น</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>เพิ่มหมวดหมู่
        </a>
    </div>
</div>

@if (inactiveCount > 0)
{
    <div class="alert alert-secondary py-2">
        แสดงหมวดหมู่ทั้งหมด @Model.Count().ToString("N0") รายการ:
        ใช้งาน @activeCount.ToString("N0") รายการ,
        ปิดใช้งาน @inactiveCount.ToString("N0") รายการ
    </div>
}

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ลำดับ</th>
                    <th>ชื่อหมวดหมู่</th>
                    <th>ชื่อคอลัมน์สี/รุ่น</th>
                    <th class="text-end">สินค้า</th>
                    <th>สถานะ</th>
                    <th class="text-end">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(!item.IsActive ? "table-secondary" : "")">
                        <td>@item.SortOrder</td>
                        <td class="fw-medium">@item.CategoryName</td>
                        <td>@item.VariantLabel</td>
                        <td class="text-end">@item.ProductCount</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">ใช้งาน</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">ปิด</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
