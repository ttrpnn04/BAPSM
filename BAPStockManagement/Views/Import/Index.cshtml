@model BAPStockManagement.ViewModels.Import.ExcelImportViewModel
@{
    ViewData["Title"] = "Import Excel";
}

<div class="page-header">
    <div>
        <h1>ตั้งต้นสต็อกจาก Excel</h1>
        <p class="subtitle">ใช้ตอน deploy / เริ่มใช้ระบบ — ตั้งยอดต้นจากสต็อกในไฟล์ แล้วเคลียร์ประวัติให้รายงานโล่ง</p>
    </div>
</div>

<div class="form-card mb-4">
    <form asp-action="Index" method="post" enctype="multipart/form-data" class="row g-3" id="deployImportForm">
        @Html.AntiForgeryToken()
        <div class="col-12">
            <label asp-for="ExcelFile" class="form-label">ไฟล์ Excel (.xlsx)</label>
            <input asp-for="ExcelFile" type="file" class="form-control" accept=".xlsx" />
            <span asp-validation-for="ExcelFile" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="form-check">
                <input asp-for="IncludeZeroStockProducts" class="form-check-input" />
                <label asp-for="IncludeZeroStockProducts" class="form-check-label">
                    นำเข้าสินค้าที่สต็อกเป็น 0 เข้า master ด้วย
                </label>
            </div>
        </div>

        <div class="col-12">
            <div class="alert alert-warning mb-2 py-2">
                <div class="fw-semibold">คำเตือน</div>
                <div class="small mb-0">
                    การนำเข้าจะ<strong>ลบประวัติเข้า–ออกทั้งหมด</strong> แล้วตั้งยอดต้นจากคอลัมน์สต็อกใน Excel เท่านั้น
                    (ไม่นำเข้าบิลรายวัน) จากนั้นให้บันทึกรายการต่อในระบบ
                </div>
            </div>
            <div class="form-check">
                <input asp-for="ConfirmResetHistory" class="form-check-input" />
                <label asp-for="ConfirmResetHistory" class="form-check-label">
                    ยืนยันว่าจะเคลียร์ประวัติทั้งหมด แล้วตั้งยอดต้นจากสต็อกใน Excel
                </label>
                <span asp-validation-for="ConfirmResetHistory" class="text-danger d-block"></span>
            </div>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary" id="deployImportBtn">
                <i class="bi bi-upload"></i>ตั้งต้นจาก Excel
            </button>
        </div>
    </form>

    <div class="mt-3 small text-muted">
        <div>ใช้ตอนตั้งต้นระบบ / deploy ไม่ใช่ซิงก์รายวัน</div>
        <div>อ่านหมวดหมู่จากคอลัมน์ C และเดือน/ปีจากชื่อไฟล์แบบ MMYY เช่น 0769</div>
        <div>ใช้บล็อกสต็อกขวาสุดที่มองเห็นในไฟล์ (ข้ามคอลัมน์ที่ถูกซ่อน)</div>
        <div>ไม่นำเข้าประวัติบิล — เอาเฉพาะยอดสต็อกเป็นยอดต้น</div>
        <div>สีใช้ชื่อตาม Excel และยางใน COLUN/BLUE นับเป็นกระสอบ/ลัง/เส้น</div>
    </div>
</div>

@if (Model.HasResult)
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") mb-4">
        @Model.ResultMessage
        @if (!string.IsNullOrWhiteSpace(Model.ImportRef))
        {
            <span class="ms-2">Ref: <code>@Model.ImportRef</code></span>
        }
    </div>
}

@if (Model.Warnings.Count > 0)
{
    <div class="alert alert-warning mb-4">
        <div class="fw-semibold mb-1">คำเตือนจากไฟล์</div>
        <ul class="mb-0">
            @foreach (var warning in Model.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

@if (Model.HasResult && Model.IsSuccess)
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-primary">
                <div>
                    <div class="stat-label">แถวที่อ่านได้</div>
                    <div class="stat-value">@Model.ParsedRows</div>
                </div>
                <div class="stat-icon"><i class="bi bi-file-earmark-text"></i></div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-success">
                <div>
                    <div class="stat-label">สินค้าใน master</div>
                    <div class="stat-value">@Model.ImportedProducts</div>
                </div>
                <div class="stat-icon"><i class="bi bi-box-seam"></i></div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-info">
                <div>
                    <div class="stat-label">รายการที่เคลียร์</div>
                    <div class="stat-value">@Model.ClearedTransactions.ToString("N0")</div>
                </div>
                <div class="stat-icon"><i class="bi bi-trash"></i></div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-warning">
                <div>
                    <div class="stat-label">ยอดต้นที่ตั้ง</div>
                    <div class="stat-value">@Model.TotalPieces.ToString("N0") ชิ้น</div>
                    <div class="small">@Model.TotalCases.ToString("N0") กระสอบ/ลัง/เส้น · @Model.OpeningTransactions.ToString("N0") รายการ</div>
                </div>
                <div class="stat-icon"><i class="bi bi-calculator"></i></div>
            </div>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <tbody>
                    <tr>
                        <th class="w-25">หมวดหมู่ที่ใช้</th>
                        <td>@string.Join(", ", Model.CategoryNames)</td>
                    </tr>
                    <tr>
                        <th>วันที่ยอดต้น</th>
                        <td>
                            @if (Model.SnapshotDate.HasValue)
                            {
                                @Model.SnapshotDate.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>สินค้าใหม่ที่สร้าง</th>
                        <td>@Model.CreatedProducts</td>
                    </tr>
                    <tr>
                        <th>สี/รุ่นใหม่ที่สร้าง</th>
                        <td>@Model.CreatedVariants</td>
                    </tr>
                    <tr>
                        <th>รายการยอดต้น</th>
                        <td>@Model.OpeningTransactions</td>
                    </tr>
                    <tr>
                        <th>สินค้าไม่มีสต็อกที่ถูกข้าม</th>
                        <td>@Model.SkippedNoStockProducts</td>
                    </tr>
                    <tr>
                        <th>คอลัมน์สีที่ระบบอ่านได้</th>
                        <td>@string.Join(", ", Model.ColorHeaders)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('deployImportForm')?.addEventListener('submit', (e) => {
            const confirm = document.getElementById('ConfirmResetHistory');
            if (confirm && !confirm.checked) {
                e.preventDefault();
                confirm.focus();
                return;
            }
            if (!window.confirm('ยืนยันตั้งต้นจาก Excel?\nระบบจะลบประวัติเข้า–ออกทั้งหมด แล้วตั้งยอดต้นใหม่จากไฟล์')) {
                e.preventDefault();
            }
        });
    </script>
}
