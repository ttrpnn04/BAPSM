@model BAPStockManagement.ViewModels.Import.ExcelImportViewModel
@{
    ViewData["Title"] = "Import Excel";
}

<div class="page-header">
    <div>
        <h1>นำเข้าข้อมูลจาก Excel</h1>
        <p class="subtitle">นำเข้าประวัติบิลรายวัน และตั้งยอดให้ตรงกับสต็อกคอลัมน์สุดท้าย</p>
    </div>
</div>

<div class="form-card mb-4">
    <form asp-action="Index" method="post" enctype="multipart/form-data" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-12">
            <label asp-for="ExcelFile" class="form-label">ไฟล์ Excel (.xlsx)</label>
            <input asp-for="ExcelFile" type="file" class="form-control" accept=".xlsx" />
            <span asp-validation-for="ExcelFile" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="form-check">
                <input asp-for="IncludeZeroStockProducts" class="form-check-input" />
                <label asp-for="IncludeZeroStockProducts" class="form-check-label">
                    นำเข้าสินค้าที่สต็อกเป็น 0 เข้า master ด้วย
                </label>
            </div>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-upload"></i>เริ่มนำเข้า
            </button>
        </div>
    </form>

    <div class="mt-3 small text-muted">
        <div>ระบบอ่านหมวดหมู่จากหัวข้อในคอลัมน์ C และอ่านเดือน/ปีจากชื่อไฟล์แบบ MMYY เช่น 0769</div>
        <div>คอลัมน์สต็อกขวาสุด = ยอดปัจจุบัน (ตั้งค่าแทนที่ ไม่บวกเพิ่ม)</div>
        <div>ไฟล์ใหม่: นำเข้าประวัติบิล + ตั้งยอดล่าสุด / ไฟล์เดิมที่เคยนำเข้าแล้ว: ซิงก์ยอดล่าสุดอย่างเดียว ไม่ใส่บิลซ้ำ</div>
        <div>สีใช้ชื่อตาม Excel 14 สี และยางใน COLUN/BLUE นับเป็นกระสอบ/ลัง</div>
    </div>
</div>

@if (Model.HasResult)
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") mb-4">
        @Model.ResultMessage
        @if (!string.IsNullOrWhiteSpace(Model.ImportRef))
        {
            <span class="ms-2">Ref: <code>@Model.ImportRef</code></span>
        }
    </div>
}

@if (Model.Warnings.Count > 0)
{
    <div class="alert alert-warning mb-4">
        <div class="fw-semibold mb-1">คำเตือนจากไฟล์</div>
        <ul class="mb-0">
            @foreach (var warning in Model.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

@if (Model.HasResult && Model.IsSuccess)
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-primary">
                <div>
                    <div class="stat-label">แถวที่อ่านได้</div>
                    <div class="stat-value">@Model.ParsedRows</div>
                </div>
                <div class="stat-icon"><i class="bi bi-file-earmark-text"></i></div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-success">
                <div>
                    <div class="stat-label">สินค้าใน master</div>
                    <div class="stat-value">@Model.ImportedProducts</div>
                </div>
                <div class="stat-icon"><i class="bi bi-box-seam"></i></div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-info">
                <div>
                    <div class="stat-label">รายการบิลออก</div>
                    <div class="stat-value">@Model.ImportedIssueTransactions</div>
                </div>
                <div class="stat-icon"><i class="bi bi-arrow-up-circle"></i></div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-warning">
                <div>
                    <div class="stat-label">ยอดล่าสุด</div>
                    <div class="stat-value">@Model.TotalPieces.ToString("N0") ชิ้น/กล่อง</div>
                    <div class="small">@Model.TotalCases.ToString("N0") กระสอบ/ลัง</div>
                </div>
                <div class="stat-icon"><i class="bi bi-calculator"></i></div>
            </div>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <tbody>
                    <tr>
                        <th class="w-25">หมวดหมู่ที่ใช้</th>
                        <td>@string.Join(", ", Model.CategoryNames)</td>
                    </tr>
                    <tr>
                        <th>ช่วงบิลที่นำเข้า</th>
                        <td>
                            บิล1–บิล@Model.BillDays
                            @if (Model.SnapshotDate.HasValue)
                            {
                                <span>(ถึงวันที่ @Model.SnapshotDate.Value.ToString("dd/MM/yyyy"))</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>สินค้าใหม่ที่สร้าง</th>
                        <td>@Model.CreatedProducts</td>
                    </tr>
                    <tr>
                        <th>สี/รุ่นใหม่ที่สร้าง</th>
                        <td>@Model.CreatedVariants</td>
                    </tr>
                    <tr>
                        <th>รายการปรับยอดเปิด</th>
                        <td>@Model.AdjustmentTransactions</td>
                    </tr>
                    <tr>
                        <th>สินค้าไม่มีสต็อกที่ถูกข้าม transaction</th>
                        <td>@Model.SkippedNoStockProducts</td>
                    </tr>
                    <tr>
                        <th>คอลัมน์สีที่ระบบอ่านได้</th>
                        <td>@string.Join(", ", Model.ColorHeaders)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
