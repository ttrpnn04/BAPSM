@model BAPStockManagement.ViewModels.Stock.EditTransactionDocumentViewModel
@{
    ViewData["Title"] = "แก้ไขบิล";
    var isOut = Model.Direction < 0;
    var initialLinesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Lines.Select(l => new
        {
            transactionId = l.TransactionId,
            productId = l.ProductId,
            variantId = l.VariantId,
            sku = l.Sku ?? "",
            label = l.VariantName ?? "",
            qtyPieces = l.QtyPieces,
            qtyCases = l.QtyCases,
            unit = l.Unit ?? ""
        }));
}

<div class="page-header">
    <div>
        <h1>แก้ไขบิล</h1>
        <p class="subtitle">
            <span class="badge @(isOut ? "bg-danger" : "bg-success")">@Model.TypeName</span>
            · เปลี่ยนสินค้า / สี / จำนวน · เพิ่มหรือลบบรรทัดได้
        </p>
    </div>
    <div class="page-actions">
        <a asp-action="Details" asp-route-id="@Model.DocumentId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>ยกเลิก
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="form-card">
            <form asp-action="Edit" asp-route-id="@Model.DocumentId" method="post" id="editTxnForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DocumentId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label">ประเภทรายการ</label>
                    <div>
                        <span class="badge @(isOut ? "bg-danger" : "bg-success") fs-6">@Model.TypeName</span>
                        <span class="text-muted small ms-2">ไม่สามารถเปลี่ยนประเภทบิลได้</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TxnDate" class="form-label"></label>
                    <input asp-for="TxnDate" class="form-control js-datepicker" type="text"
                           value="@Model.TxnDate.ToString("yyyy-MM-dd")"
                           placeholder="เลือกวันที่" autocomplete="off" />
                    <span asp-validation-for="TxnDate" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RefNo" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="RefNo" class="form-control" placeholder="เช่น ร้าน A, PO-001" maxlength="50" required />
                    <span asp-validation-for="RefNo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Note" class="form-label"></label>
                    <textarea asp-for="Note" class="form-control" rows="2" maxlength="300"></textarea>
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>

                <hr class="my-4" />
                <h2 class="h6 mb-3">รายการในบิล</h2>

                <div class="mb-3">
                    <label class="form-label">สินค้า</label>
                    <input type="search" id="productSearch" class="form-control form-control-sm mb-2"
                           placeholder="ค้นหาสินค้า..." autocomplete="off" />
                    <select id="productSelect" class="form-select" asp-items="ViewBag.Products">
                        <option value="">-- เลือกสินค้า --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" id="variantFieldLabel">สี/รุ่น <span class="text-danger">*</span></label>
                    <input type="hidden" id="variantHidden" value="" />
                    <div id="variantChips" class="variant-chip-grid">
                        <span class="text-muted small fst-italic">เลือกสินค้าก่อน</span>
                    </div>
                    <div id="variantData" hidden>
                        @foreach (var variant in ViewBag.Variants)
                        {
                            <span data-variant-id="@variant.VariantId"
                                  data-product-id="@variant.ProductId"
                                  data-sku="@variant.Sku"
                                  data-unit="@variant.Unit"
                                  data-qty-pieces="@variant.QtyPieces"
                                  data-qty-cases="@variant.QtyCases"
                                  data-label="@variant.Label"></span>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" id="qtyFieldLabel">จำนวน</label>
                    <input id="QtyValue" class="form-control qty-input" type="text"
                           inputmode="numeric" autocomplete="off" placeholder="กรอกจำนวน" />
                    <div class="form-text" id="qtyFieldHint">ระบบจะแยกเป็นชิ้น หรือ กระสอบ/ลัง/เส้น ให้อัตโนมัติตามสินค้าที่เลือก</div>
                </div>

                <div class="mb-3">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="addTxnLineBtn">
                        <i class="bi bi-plus-circle me-1"></i>เพิ่มรายการ
                    </button>
                </div>

                <div class="table-responsive mb-3" id="txnLinesWrap">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>รหัสสินค้า</th>
                                <th>สี/หน่วย</th>
                                <th class="text-end">จำนวน</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody id="txnLinesBody"></tbody>
                    </table>
                    <div id="txnLinesInputs"></div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary" id="editSubmitBtn">
                            <i class="bi bi-check-lg me-1"></i>บันทึกการแก้ไข
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.DocumentId" class="btn btn-outline-secondary">ยกเลิก</a>
                    </div>
                </div>
            </form>

            <form asp-action="Delete" asp-route-id="@Model.DocumentId" method="post" class="mt-4 pt-3 border-top"
                  onsubmit="return confirm('ยืนยันลบบิลนี้ทั้งหมด? ระบบจะคืนยอดสต็อกของบิลนี้');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i>ลบบิลทั้งใบ
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (() => {
        const billDirection = @Model.Direction;
        const initialLines = @Html.Raw(initialLinesJson);

        const palette = [
            { keys: ['ดำ'],                      bg: '#1e293b', text: '#f8fafc', dot: '#94a3b8' },
            { keys: ['แดง'],                     bg: '#fee2e2', text: '#991b1b', dot: '#ef4444' },
            { keys: ['น้ำเงิน'],                 bg: '#dbeafe', text: '#1e40af', dot: '#3b82f6' },
            { keys: ['ฟ้า','ธงฟ้า'],            bg: '#e0f2fe', text: '#0369a1', dot: '#0ea5e9' },
            { keys: ['ส้ม'],                     bg: '#ffedd5', text: '#9a3412', dot: '#f97316' },
            { keys: ['เขียว'],                   bg: '#d1fae5', text: '#065f46', dot: '#10b981' },
            { keys: ['ชมพูเข้ม','ชมเข้ม','ชมพู','ชม'], bg: '#fce7f3', text: '#9d174d', dot: '#ec4899' },
            { keys: ['ทอง'],                     bg: '#fef3c7', text: '#78350f', dot: '#f59e0b' },
            { keys: ['เหลือง','ครีม'],           bg: '#fef9c3', text: '#713f12', dot: '#eab308' },
            { keys: ['ม่วง'],                    bg: '#ede9fe', text: '#4c1d95', dot: '#8b5cf6' },
            { keys: ['น้ำตาล','ตาล'],            bg: '#fef3c7', text: '#92400e', dot: '#b45309' },
            { keys: ['เทา'],                     bg: '#f1f5f9', text: '#475569', dot: '#94a3b8' },
            { keys: ['ขาว'],                     bg: '#f8fafc', text: '#334155', dot: '#cbd5e1' },
            { keys: ['วัว'],                     bg: '#fef2f2', text: '#7f1d1d', dot: '#fca5a5' },
        ];
        function resolveColor(name) {
            for (const e of palette) {
                if (e.keys.some(k => name.includes(k))) return e;
            }
            return { bg: '#f4f4f5', text: '#52525b', dot: '#94a3b8' };
        }

        const form           = document.getElementById('editTxnForm');
        const productSelect  = document.getElementById('productSelect');
        const productSearch  = document.getElementById('productSearch');
        const variantChips   = document.getElementById('variantChips');
        const variantHidden  = document.getElementById('variantHidden');
        const variantDataEl  = document.getElementById('variantData');
        const qtyValueInput  = document.getElementById('QtyValue');
        const qtyFieldLabel  = document.getElementById('qtyFieldLabel');
        const qtyFieldHint   = document.getElementById('qtyFieldHint');
        const addLineBtn     = document.getElementById('addTxnLineBtn');
        const linesWrap      = document.getElementById('txnLinesWrap');
        const linesBody      = document.getElementById('txnLinesBody');
        const linesInputs    = document.getElementById('txnLinesInputs');
        const variantFieldLabel = document.getElementById('variantFieldLabel');

        if (!form || !productSelect || !variantDataEl) return;

        const allVariants = Array.from(variantDataEl.querySelectorAll('[data-variant-id]'))
            .map(el => ({
                variantId: el.dataset.variantId,
                productId: el.dataset.productId,
                sku:       el.dataset.sku,
                unit:      el.dataset.unit || '',
                qtyPieces: Number.parseInt(el.dataset.qtyPieces || '0', 10),
                qtyCases:  Number.parseInt(el.dataset.qtyCases || '0', 10),
                label:     el.dataset.label,
            }));

        const txnLines = (initialLines || []).map(l => ({
            transactionId: l.transactionId || null,
            productId: String(l.productId),
            variantId: String(l.variantId),
            sku: l.sku,
            label: l.label,
            qtyPieces: l.qtyPieces || 0,
            qtyCases: l.qtyCases || 0,
            unit: l.unit || ''
        }));

        const productOptions = Array.from(productSelect.options).map(option => ({
            option,
            value: option.value,
            text: option.textContent.toLowerCase(),
        }));

        function filterProducts(query) {
            const term = query.trim().toLowerCase();
            productOptions.forEach(({ option, value, text }) => {
                option.hidden = !!value && !!term && !text.includes(term);
            });
        }

        function isCaseUnit(unit) {
            const value = unit || '';
            return value.includes('ลัง') || value.includes('กระสอบ') || value.includes('เส้น');
        }

        function isCaseVariant(variant) {
            return !!variant && isCaseUnit(variant.unit);
        }

        function stockLabel(v) {
            if (v.qtyPieces > 0 && v.qtyCases > 0) {
                return `${v.qtyPieces.toLocaleString()} ชิ้น / ${v.qtyCases.toLocaleString()} กระสอบ/ลัง/เส้น`;
            }
            if (v.qtyCases > 0) return `${v.qtyCases.toLocaleString()} กระสอบ/ลัง/เส้น`;
            return `${v.qtyPieces.toLocaleString()} ชิ้น`;
        }

        function updateQtyFieldForVariant(variant) {
            const caseItem = isCaseVariant(variant);
            if (qtyFieldLabel) {
                qtyFieldLabel.textContent = caseItem ? 'จำนวน (กระสอบ/ลัง/เส้น)' : 'จำนวน (ชิ้น)';
            }
            if (qtyFieldHint) {
                qtyFieldHint.textContent = caseItem
                    ? 'สินค้านี้บันทึกเป็นกระสอบ/ลัง/เส้น'
                    : 'สินค้านี้บันทึกเป็นชิ้น';
            }
            qtyValueInput.placeholder = caseItem ? 'กรอกจำนวนกระสอบ/ลัง/เส้น' : 'กรอกจำนวนชิ้น';
        }

        function selectVariant(btn, id) {
            variantChips.querySelectorAll('.variant-chip-btn').forEach(b => b.classList.remove('is-selected'));
            btn.classList.add('is-selected');
            variantHidden.value = id;
            updateQtyFieldForVariant(allVariants.find(v => v.variantId === id));
        }

        function buildChips(productId) {
            const isSale = billDirection < 0;
            const filtered = allVariants.filter(v =>
                v.productId === productId &&
                (!isSale || v.qtyPieces > 0 || v.qtyCases > 0 || txnLines.some(l => l.variantId === v.variantId))
            );
            variantChips.innerHTML = '';
            variantHidden.value = '';

            const caseOnly = filtered.length > 0 && filtered.every(v => isCaseUnit(v.unit));
            if (variantFieldLabel) {
                variantFieldLabel.innerHTML = caseOnly
                    ? 'หน่วย <span class="text-danger">*</span>'
                    : 'สี/รุ่น <span class="text-danger">*</span>';
            }

            if (!filtered.length) {
                variantChips.innerHTML = productId
                    ? '<span class="text-muted small fst-italic">ไม่พบหน่วยสินค้า</span>'
                    : '<span class="text-muted small fst-italic">เลือกสินค้าก่อน</span>';
                return;
            }

            filtered.forEach(v => {
                const col = resolveColor(v.label);
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'variant-chip-btn';
                btn.dataset.variantId = v.variantId;
                btn.style.setProperty('--chip-bg',   col.bg);
                btn.style.setProperty('--chip-text', col.text);
                btn.style.setProperty('--chip-dot',  col.dot);

                const skuEl = document.createElement('code');
                skuEl.className = 'variant-chip-btn__sku';
                skuEl.textContent = v.sku;

                const swatch = document.createElement('span');
                swatch.className = 'color-swatch color-swatch--variant-choice';
                swatch.title = `${v.label} — คงเหลือ ${stockLabel(v)}`;

                const fill = document.createElement('span');
                fill.className = 'color-swatch__fill';
                fill.textContent = isSale ? stockLabel(v) : '';

                const label = document.createElement('span');
                label.className = 'color-swatch__label';
                label.textContent = v.label === 'มาตรฐาน' ? (caseOnly ? 'กระสอบ/ลัง/เส้น' : 'มาตรฐาน') : v.label;

                swatch.appendChild(fill);
                swatch.appendChild(label);
                btn.appendChild(skuEl);
                btn.appendChild(swatch);
                btn.addEventListener('click', () => selectVariant(btn, v.variantId));
                variantChips.appendChild(btn);
            });

            const preferred = (caseOnly ? filtered.find(v => v.label === 'มาตรฐาน') : null) ||
                (filtered.length === 1 ? filtered[0] : null) ||
                filtered.find(v => v.label === 'มาตรฐาน') ||
                filtered[0];
            if (preferred) {
                const btn = variantChips.querySelector(`[data-variant-id="${preferred.variantId}"]`);
                if (btn) selectVariant(btn, preferred.variantId);
            }
        }

        function sanitizeQtyInput(input) {
            const sanitized = input.value.replace(/\D/g, '').replace(/^0+(?=\d)/, '');
            if (input.value !== sanitized) input.value = sanitized;
        }

        function readQty(input) {
            const value = Number.parseInt(input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : 0;
        }

        function splitQty(variant, qty) {
            if (isCaseVariant(variant)) {
                return { qtyPieces: 0, qtyCases: qty };
            }
            return { qtyPieces: qty, qtyCases: 0 };
        }

        qtyValueInput.addEventListener('input', () => sanitizeQtyInput(qtyValueInput));
        qtyValueInput.addEventListener('focus', () => {
            if (qtyValueInput.value === '0') qtyValueInput.value = '';
        });

        function renderTxnLines() {
            linesWrap.classList.toggle('d-none', txnLines.length === 0);
            linesBody.innerHTML = '';
            linesInputs.innerHTML = '';

            txnLines.forEach((line, index) => {
                const col = resolveColor(line.label);
                const tr = document.createElement('tr');

                const skuTd = document.createElement('td');
                const skuCode = document.createElement('code');
                skuCode.textContent = line.sku;
                skuTd.appendChild(skuCode);

                const colorTd = document.createElement('td');
                const swatch = document.createElement('span');
                swatch.className = 'color-swatch color-swatch--txn-line';
                swatch.style.setProperty('--swatch-color', col.dot);
                swatch.title = line.label;
                const fill = document.createElement('span');
                fill.className = 'color-swatch__fill';
                fill.textContent = line.qtyPieces
                    ? line.qtyPieces.toLocaleString()
                    : (line.qtyCases ? line.qtyCases.toLocaleString() : '');
                const label = document.createElement('span');
                label.className = 'color-swatch__label';
                label.textContent = line.label === 'มาตรฐาน' ? 'กระสอบ/ลัง/เส้น' : line.label;
                swatch.appendChild(fill);
                swatch.appendChild(label);
                colorTd.appendChild(swatch);

                const qtyTd = document.createElement('td');
                qtyTd.className = 'text-end';
                qtyTd.textContent = line.qtyCases > 0
                    ? `${line.qtyCases.toLocaleString()} กระสอบ/ลัง/เส้น`
                    : `${line.qtyPieces.toLocaleString()} ชิ้น`;

                const actionTd = document.createElement('td');
                actionTd.className = 'text-end';
                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'btn btn-sm btn-outline-danger remove-txn-line';
                removeBtn.dataset.index = String(index);
                removeBtn.innerHTML = '<i class="bi bi-trash"></i>';
                actionTd.appendChild(removeBtn);

                tr.appendChild(skuTd);
                tr.appendChild(colorTd);
                tr.appendChild(qtyTd);
                tr.appendChild(actionTd);
                linesBody.appendChild(tr);

                const fields = [
                    ['TransactionId', line.transactionId || ''],
                    ['ProductId', line.productId],
                    ['VariantId', line.variantId],
                    ['QtyPieces', line.qtyPieces],
                    ['QtyCases', line.qtyCases]
                ];
                fields.forEach(([name, value]) => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = `Lines[${index}].${name}`;
                    input.value = String(value);
                    linesInputs.appendChild(input);
                });
            });
        }

        function addCurrentLine(showAlert = true) {
            const variantId = variantHidden.value;
            const variant = allVariants.find(v => v.variantId === variantId);
            const qty = readQty(qtyValueInput);

            if (!variantId || !variant) {
                if (showAlert) alert('กรุณาเลือกสินค้า/หน่วยก่อนเพิ่มรายการ');
                return false;
            }

            if (qty === 0) {
                if (showAlert) alert(isCaseVariant(variant)
                    ? 'กรุณาระบุจำนวนกระสอบ/ลัง/เส้นอย่างน้อย 1'
                    : 'กรุณาระบุจำนวนชิ้นอย่างน้อย 1');
                return false;
            }

            const { qtyPieces, qtyCases } = splitQty(variant, qty);
            const existing = txnLines.find(line => line.variantId === variantId);
            if (existing) {
                existing.qtyPieces += qtyPieces;
                existing.qtyCases += qtyCases;
            } else {
                txnLines.push({
                    transactionId: null,
                    productId: variant.productId,
                    variantId,
                    sku: variant.sku,
                    label: variant.label,
                    qtyPieces,
                    qtyCases,
                    unit: variant.unit
                });
            }

            qtyValueInput.value = '';
            renderTxnLines();
            productSearch.focus();
            productSearch.select();
            return true;
        }

        productSelect.addEventListener('change', () => buildChips(productSelect.value));
        productSearch.addEventListener('input', () => filterProducts(productSearch.value));
        addLineBtn.addEventListener('click', () => addCurrentLine());

        linesBody.addEventListener('click', (e) => {
            const removeBtn = e.target.closest('.remove-txn-line');
            if (!removeBtn) return;
            txnLines.splice(Number.parseInt(removeBtn.dataset.index, 10), 1);
            renderTxnLines();
        });

        form.addEventListener('keydown', (e) => {
            if (e.key !== 'Enter') return;
            if (e.target.tagName === 'TEXTAREA') return;
            if (e.target.closest('#editSubmitBtn')) return;
            e.preventDefault();
            if (e.target.closest('button, a')) return;
            addCurrentLine();
        });

        form.addEventListener('submit', (e) => e.preventDefault());

        document.getElementById('editSubmitBtn')?.addEventListener('click', () => {
            const refNoInput = form.querySelector('[name="RefNo"]');
            if (refNoInput && !refNoInput.value.trim()) {
                refNoInput.classList.add('is-invalid');
                refNoInput.focus();
                return;
            }
            if (refNoInput) refNoInput.classList.remove('is-invalid');

            if (txnLines.length === 0) {
                const hasDraftQty = readQty(qtyValueInput) > 0;
                if (hasDraftQty) addCurrentLine(false);
            }

            if (txnLines.length === 0) {
                alert('กรุณาเพิ่มรายการอย่างน้อย 1 รายการ');
                return;
            }

            renderTxnLines();
            HTMLFormElement.prototype.submit.call(form);
        });

        renderTxnLines();
    })();
    </script>
}
