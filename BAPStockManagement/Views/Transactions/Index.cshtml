@model BAPStockManagement.ViewModels.Stock.TransactionIndexViewModel
@{
    ViewData["Title"] = "ประวัติรายการสต็อก";
}

<div class="page-header">
    <div>
        <h1>ประวัติรายการสต็อก</h1>
        <p class="subtitle">รายการรับเข้าและจ่ายออกย้อนหลัง</p>
    </div>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>บันทึกรายการ
            </a>
        </div>
    }
</div>

<div class="filter-bar">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">จากวันที่</label>
            <input type="text" name="fromDate" value="@Model.FromDate?.ToString("dd/MM/yyyy")"
                   class="form-control" placeholder="วัน/เดือน/ปี" inputmode="numeric" />
        </div>
        <div class="col-md-2">
            <label class="form-label">ถึงวันที่</label>
            <input type="text" name="toDate" value="@Model.ToDate?.ToString("dd/MM/yyyy")"
                   class="form-control" placeholder="วัน/เดือน/ปี" inputmode="numeric" />
        </div>
        <div class="col-md-2">
            <label class="form-label">ประเภท</label>
            <select name="transactionTypeId" class="form-select">
                <option value="">ทั้งหมด</option>
                @foreach (var type in Model.TransactionTypes)
                {
                    if (Model.TransactionTypeId == type.TransactionTypeId)
                    {
                        <option value="@type.TransactionTypeId" selected>@type.TypeName</option>
                    }
                    else
                    {
                        <option value="@type.TransactionTypeId">@type.TypeName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">ค้นหา</label>
            <input type="text" name="search" value="@Model.Search" class="form-control"
                   placeholder="SKU, ชื่อสินค้า, เลขที่อ้างอิง" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>ค้นหา</button>
            <a asp-action="Index" class="btn btn-outline-secondary">ล้าง</a>
        </div>
    </form>
</div>

@if (!Model.Items.Any())
{
    <div class="card-app">
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-journal-x"></i></div>
            <p class="mb-0">ไม่พบรายการ</p>
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>วันที่</th>
                        <th>ประเภท</th>
                        <th>หมวดหมู่</th>
                        <th>SKU</th>
                        <th>ชื่อสินค้า</th>
                        <th>สี/รุ่น</th>
                        <th class="text-end">ชิ้น</th>
                        <th class="text-end">ลัง</th>
                        <th>เลขที่อ้างอิง</th>
                        <th>ผู้บันทึก</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var isOut = item.Direction < 0;
                        <tr>
                            <td class="text-muted small">@item.TxnDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @(isOut ? "bg-danger" : "bg-success")">@item.TypeName</span>
                            </td>
                            <td><span class="text-muted small">@item.CategoryName</span></td>
                            <td><code>@item.Sku</code></td>
                            <td class="fw-medium">@item.ProductName</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.VariantName))
                                {
                                    <span class="color-swatch color-swatch--table" data-vname="@item.VariantName" title="@item.VariantName">
                                        <span class="color-swatch__fill"></span>
                                        <span class="color-swatch__label">@item.VariantName</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-end fw-semibold @(isOut ? "text-danger" : "text-success")">
                                @(isOut ? "-" : "+")@item.QtyPieces.ToString("N0")
                            </td>
                            <td class="text-end fw-semibold @(isOut ? "text-danger" : "text-success")">
                                @(isOut ? "-" : "+")@item.QtyCases.ToString("N0")
                            </td>
                            <td>@(item.RefNo ?? "-")</td>
                            <td><span class="text-muted small">@(item.CreatedBy ?? "-")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="small text-muted">
            ทั้งหมด @Model.TotalItems รายการ | หน้า @Model.Page / @Model.TotalPages
        </div>
        <nav aria-label="pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-transactionTypeId="@Model.TransactionTypeId"
                       asp-route-search="@Model.Search"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-page="@(Model.Page - 1)">ก่อนหน้า</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@Model.Page / @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-transactionTypeId="@Model.TransactionTypeId"
                       asp-route-search="@Model.Search"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-page="@(Model.Page + 1)">ถัดไป</a>
                </li>
            </ul>
        </nav>
    </div>
}

