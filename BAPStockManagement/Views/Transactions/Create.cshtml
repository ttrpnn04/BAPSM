@model BAPStockManagement.ViewModels.Stock.CreateTransactionViewModel
@{
    ViewData["Title"] = "บันทึกรายการสต็อก";
}

<div class="page-header">
    <div>
        <h1>บันทึกรายการสต็อก</h1>
        <p class="subtitle">รับเข้า หรือ จ่ายออกสินค้า</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="form-card">
            <form asp-action="Create" method="post" id="createTxnForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label"></label>
                    <input type="search" id="productSearch" class="form-control form-control-sm mb-2"
                           placeholder="ค้นหาสินค้า..." autocomplete="off" />
                    <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select" id="productSelect">
                        <option value="">-- เลือกสินค้า --</option>
                    </select>
                    <span asp-validation-for="ProductId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">สี/รุ่น <span class="text-danger">*</span></label>
                    <input type="hidden" asp-for="VariantId" id="variantHidden" />
                    <div id="variantChips" class="variant-chip-grid">
                        <span class="text-muted small fst-italic">เลือกสินค้าก่อน</span>
                    </div>
                    @* เก็บข้อมูล variants ทั้งหมดไว้ใน data attribute *@
                    <div id="variantData" hidden>
                        @foreach (var variant in ViewBag.Variants)
                        {
                            <span data-variant-id="@variant.VariantId"
                                  data-product-id="@variant.ProductId"
                                  data-sku="@variant.Sku"
                                  data-qty-pieces="@variant.QtyPieces"
                                  data-qty-cases="@variant.QtyCases"
                                  data-label="@variant.Label"></span>
                        }
                    </div>
                    <span asp-validation-for="VariantId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">ประเภทรายการ <span class="text-danger">*</span></label>
                    <div class="txn-type-group" role="group">
                        @{
                            var transactionTypes = ((IEnumerable<BAPStockManagement.Models.TransactionType>)ViewBag.TransactionTypesList).ToList();
                        }
                        @for (var i = 0; i < transactionTypes.Count; i++)
                        {
                            var type      = transactionTypes[i];
                            var isIn      = type.Direction > 0;
                            var isChecked = Model.TransactionTypeId == type.TransactionTypeId;
                            var sameDirectionIndex = transactionTypes.Take(i).Count(t => t.Direction == type.Direction);
                            var typeLabel = isIn
                                ? (sameDirectionIndex == 0 ? "รับสต็อกเข้า" : "ปรับยอดเพิ่ม")
                                : (sameDirectionIndex == 0 ? "ขายออก" : "ปรับยอดลง");
                            <label class="txn-type-pill @(isIn ? "txn-type-pill--in" : "txn-type-pill--out") @(isChecked ? "is-checked" : "")">
                                <input type="radio" name="TransactionTypeId" value="@type.TransactionTypeId"
                                       data-direction="@type.Direction"
                                       @(isChecked ? "checked" : "") />
                                <i class="bi @(isIn ? "bi-arrow-down-circle" : "bi-arrow-up-circle")"></i>
                                @typeLabel
                            </label>
                        }
                    </div>
                    <span asp-validation-for="TransactionTypeId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TxnDate" class="form-label"></label>
                    <input asp-for="TxnDate" class="form-control" type="text"
                           value="@Model.TxnDate.ToString("dd/MM/yyyy")"
                           placeholder="วัน/เดือน/ปี" inputmode="numeric" />
                    <span asp-validation-for="TxnDate" class="text-danger small"></span>
                </div>

                <div class="row align-items-end">
                    <div class="col-md-6 mb-3">
                        <label asp-for="QtyPieces" class="form-label"></label>
                        <input asp-for="QtyPieces" class="form-control" type="number" min="0" />
                        <span asp-validation-for="QtyPieces" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="QtyCases" class="form-label"></label>
                        <input asp-for="QtyCases" class="form-control" type="number" min="0" />
                        <span asp-validation-for="QtyCases" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="addTxnLineBtn">
                        <i class="bi bi-plus-circle me-1"></i>เพิ่มรายการ
                    </button>
                    <div class="form-text">เพิ่มได้หลายสี/รุ่น แล้วกดบันทึกครั้งเดียว</div>
                </div>

                <div class="table-responsive mb-3 d-none" id="txnLinesWrap">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>รหัสสินค้า</th>
                                <th>สี/รุ่น</th>
                                <th class="text-end">ชิ้น</th>
                                <th class="text-end">ลัง</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody id="txnLinesBody"></tbody>
                    </table>
                    <div id="txnLinesInputs"></div>
                </div>

                <div class="mb-3">
                    <label asp-for="RefNo" class="form-label"></label>
                    <input asp-for="RefNo" class="form-control" placeholder="เช่น PO-001, INV-123" />
                    <span asp-validation-for="RefNo" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Note" class="form-label"></label>
                    <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>บันทึก
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (() => {
        /* ── color palette (same as stock page) ── */
        const palette = [
            { keys: ['ดำ'],                      bg: '#1e293b', text: '#f8fafc', dot: '#94a3b8' },
            { keys: ['แดง'],                     bg: '#fee2e2', text: '#991b1b', dot: '#ef4444' },
            { keys: ['น้ำเงิน'],                 bg: '#dbeafe', text: '#1e40af', dot: '#3b82f6' },
            { keys: ['ฟ้า','ธงฟ้า'],            bg: '#e0f2fe', text: '#0369a1', dot: '#0ea5e9' },
            { keys: ['ส้ม'],                     bg: '#ffedd5', text: '#9a3412', dot: '#f97316' },
            { keys: ['เขียวออ่อน','เขียวอ่อน'], bg: '#dcfce7', text: '#166534', dot: '#4ade80' },
            { keys: ['เขียว'],                   bg: '#d1fae5', text: '#065f46', dot: '#10b981' },
            { keys: ['ชมพูอ่อน'],                bg: '#fdf2f8', text: '#9d174d', dot: '#f9a8d4' },
            { keys: ['ชมพูเข้ม','ชมพู','ชม'],   bg: '#fce7f3', text: '#9d174d', dot: '#ec4899' },
            { keys: ['ทอง'],                     bg: '#fef3c7', text: '#78350f', dot: '#f59e0b' },
            { keys: ['เหลือง','ครีม'],           bg: '#fef9c3', text: '#713f12', dot: '#eab308' },
            { keys: ['ม่วง'],                    bg: '#ede9fe', text: '#4c1d95', dot: '#8b5cf6' },
            { keys: ['น้ำตาล'],                  bg: '#fef3c7', text: '#92400e', dot: '#b45309' },
            { keys: ['เทา'],                     bg: '#f1f5f9', text: '#475569', dot: '#94a3b8' },
            { keys: ['ขาว'],                     bg: '#f8fafc', text: '#334155', dot: '#cbd5e1' },
            { keys: ['วัว'],                     bg: '#fef2f2', text: '#7f1d1d', dot: '#fca5a5' },
        ];
        function resolveColor(name) {
            for (const e of palette) {
                if (e.keys.some(k => name.includes(k))) return e;
            }
            return { bg: '#f4f4f5', text: '#52525b', dot: '#94a3b8' };
        }

        /* ── elements ── */
        const form           = document.getElementById('createTxnForm');
        const productSelect  = document.getElementById('productSelect');
        const productSearch  = document.getElementById('productSearch');
        const variantChips   = document.getElementById('variantChips');
        const variantHidden  = document.getElementById('variantHidden');
        const variantDataEl  = document.getElementById('variantData');
        const qtyPiecesInput = document.getElementById('QtyPieces');
        const qtyCasesInput  = document.getElementById('QtyCases');
        const addLineBtn     = document.getElementById('addTxnLineBtn');
        const linesWrap      = document.getElementById('txnLinesWrap');
        const linesBody      = document.getElementById('txnLinesBody');
        const linesInputs    = document.getElementById('txnLinesInputs');

        if (!form || !productSelect || !productSearch || !variantChips || !variantHidden || !variantDataEl ||
            !qtyPiecesInput || !qtyCasesInput || !addLineBtn || !linesWrap || !linesBody || !linesInputs) return;

        /* read all variants from DOM data */
        const allVariants = Array.from(variantDataEl.querySelectorAll('[data-variant-id]'))
            .map(el => ({
                variantId: el.dataset.variantId,
                productId: el.dataset.productId,
                sku:       el.dataset.sku,
                qtyPieces: Number.parseInt(el.dataset.qtyPieces || '0', 10),
                qtyCases:  Number.parseInt(el.dataset.qtyCases || '0', 10),
                label:     el.dataset.label,
            }));

        const initialVariantId = variantHidden.value;
        const txnLines = [];

        const productOptions = Array.from(productSelect.options).map(option => ({
            option,
            value: option.value,
            text: option.textContent.toLowerCase(),
        }));

        function filterProducts(query) {
            const term = query.trim().toLowerCase();
            productOptions.forEach(({ option, value, text }) => {
                option.hidden = !!value && !!term && !text.includes(term);
            });
        }

        function currentDirection() {
            const checkedType = form.querySelector('input[name="TransactionTypeId"]:checked');
            return Number.parseInt(checkedType?.dataset.direction || '0', 10);
        }

        function buildChips(productId) {
            const direction = currentDirection();
            const isSale = direction < 0;
            const filtered = allVariants.filter(v =>
                v.productId === productId &&
                (!isSale || v.qtyPieces > 0 || v.qtyCases > 0)
            );
            variantChips.innerHTML = '';
            variantHidden.value = '';

            if (!filtered.length) {
                variantChips.innerHTML = productId
                    ? (isSale
                        ? '<span class="text-muted small fst-italic">ไม่มีสี/รุ่นที่มีสต็อก</span>'
                        : '<span class="text-muted small fst-italic">ไม่พบสี/รุ่น</span>')
                    : '<span class="text-muted small fst-italic">เลือกสินค้าก่อน</span>';
                return;
            }

            filtered.forEach(v => {
                const col = resolveColor(v.label);
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'variant-chip-btn';
                btn.dataset.variantId = v.variantId;
                btn.style.setProperty('--chip-bg',   col.bg);
                btn.style.setProperty('--chip-text', col.text);
                btn.style.setProperty('--chip-dot',  col.dot);
                if (v.variantId === initialVariantId) {
                    btn.classList.add('is-selected');
                    variantHidden.value = v.variantId;
                }

                const skuEl = document.createElement('code');
                skuEl.className = 'variant-chip-btn__sku';
                skuEl.textContent = v.sku;

                const swatch = document.createElement('span');
                swatch.className = 'color-swatch color-swatch--variant-choice';
                swatch.title = `${v.label} — คงเหลือ ${v.qtyPieces.toLocaleString()} ชิ้น, ${v.qtyCases.toLocaleString()} ลัง`;

                const fill = document.createElement('span');
                fill.className = 'color-swatch__fill';
                fill.textContent = isSale ? v.qtyPieces.toLocaleString() : '';

                const label = document.createElement('span');
                label.className = 'color-swatch__label';
                label.textContent = v.label;

                swatch.appendChild(fill);
                swatch.appendChild(label);
                btn.appendChild(skuEl);
                btn.appendChild(swatch);
                btn.addEventListener('click', () => selectVariant(btn, v.variantId));
                variantChips.appendChild(btn);
            });
        }

        function selectVariant(btn, id) {
            variantChips.querySelectorAll('.variant-chip-btn').forEach(b => b.classList.remove('is-selected'));
            btn.classList.add('is-selected');
            variantHidden.value = id;
        }

        function readQty(input) {
            const value = Number.parseInt(input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : 0;
        }

        function renderTxnLines() {
            linesWrap.classList.toggle('d-none', txnLines.length === 0);
            linesBody.innerHTML = '';
            linesInputs.innerHTML = '';

            txnLines.forEach((line, index) => {
                const col = resolveColor(line.label);
                const tr = document.createElement('tr');

                const skuTd = document.createElement('td');
                const skuCode = document.createElement('code');
                skuCode.textContent = line.sku;
                skuTd.appendChild(skuCode);

                const colorTd = document.createElement('td');
                const swatch = document.createElement('span');
                swatch.className = 'color-swatch color-swatch--txn-line';
                swatch.style.setProperty('--swatch-color', col.dot);
                swatch.title = line.label;
                const fill = document.createElement('span');
                fill.className = 'color-swatch__fill';
                fill.textContent = line.qtyPieces ? line.qtyPieces.toLocaleString() : '';
                const label = document.createElement('span');
                label.className = 'color-swatch__label';
                label.textContent = line.label;
                swatch.appendChild(fill);
                swatch.appendChild(label);
                colorTd.appendChild(swatch);

                const piecesTd = document.createElement('td');
                piecesTd.className = 'text-end';
                piecesTd.textContent = line.qtyPieces.toLocaleString();

                const casesTd = document.createElement('td');
                casesTd.className = 'text-end';
                casesTd.textContent = line.qtyCases.toLocaleString();

                const actionTd = document.createElement('td');
                actionTd.className = 'text-end';
                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'btn btn-sm btn-outline-danger remove-txn-line';
                removeBtn.dataset.index = String(index);
                removeBtn.innerHTML = '<i class="bi bi-trash"></i>';
                actionTd.appendChild(removeBtn);

                tr.appendChild(skuTd);
                tr.appendChild(colorTd);
                tr.appendChild(piecesTd);
                tr.appendChild(casesTd);
                tr.appendChild(actionTd);
                linesBody.appendChild(tr);

                const variantInput = document.createElement('input');
                variantInput.type = 'hidden';
                variantInput.name = `Lines[${index}].VariantId`;
                variantInput.value = String(line.variantId);
                const piecesInput = document.createElement('input');
                piecesInput.type = 'hidden';
                piecesInput.name = `Lines[${index}].QtyPieces`;
                piecesInput.value = String(line.qtyPieces);
                const casesInput = document.createElement('input');
                casesInput.type = 'hidden';
                casesInput.name = `Lines[${index}].QtyCases`;
                casesInput.value = String(line.qtyCases);
                linesInputs.appendChild(variantInput);
                linesInputs.appendChild(piecesInput);
                linesInputs.appendChild(casesInput);
            });
        }

        function addCurrentLine(showAlert = true) {
            const variantId = variantHidden.value;
            const qtyPieces = readQty(qtyPiecesInput);
            const qtyCases = readQty(qtyCasesInput);
            const variant = allVariants.find(v => v.variantId === variantId);

            if (!variantId || !variant) {
                if (showAlert) alert('กรุณาเลือกสี/รุ่นก่อนเพิ่มรายการ');
                return false;
            }

            if (qtyPieces === 0 && qtyCases === 0) {
                if (showAlert) alert('กรุณาระบุจำนวนชิ้นหรือลังอย่างน้อย 1 รายการ');
                return false;
            }

            const existing = txnLines.find(line => line.variantId === variantId);
            if (existing) {
                existing.qtyPieces += qtyPieces;
                existing.qtyCases += qtyCases;
            } else {
                txnLines.push({
                    variantId,
                    sku: variant.sku,
                    label: variant.label,
                    qtyPieces,
                    qtyCases
                });
            }

            qtyPiecesInput.value = 0;
            qtyCasesInput.value = 0;
            renderTxnLines();
            return true;
        }

        productSelect.addEventListener('change', () => {
            buildChips(productSelect.value);
        });

        productSearch.addEventListener('input', () => filterProducts(productSearch.value));
        addLineBtn.addEventListener('click', () => addCurrentLine());

        linesBody.addEventListener('click', (e) => {
            const removeBtn = e.target.closest('.remove-txn-line');
            if (!removeBtn) return;

            txnLines.splice(Number.parseInt(removeBtn.dataset.index, 10), 1);
            renderTxnLines();
        });

        form.addEventListener('submit', (e) => {
            if (txnLines.length > 0) return;

            const hasDraftQty = readQty(qtyPiecesInput) > 0 || readQty(qtyCasesInput) > 0;
            if (hasDraftQty && addCurrentLine(false)) return;
        });

        /* init */
        if (productSelect.value) buildChips(productSelect.value);

        /* ── txn-type pill toggle ── */
        document.querySelectorAll('.txn-type-pill input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.txn-type-pill').forEach(p => p.classList.remove('is-checked'));
                if (radio.checked) radio.closest('.txn-type-pill').classList.add('is-checked');
                buildChips(productSelect.value);
            });
        });
    })();
    </script>
}
