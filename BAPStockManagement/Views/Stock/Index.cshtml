@model BAPStockManagement.ViewModels.Stock.StockIndexViewModel
@{
    ViewData["Title"] = "สต็อกสินค้า";
}

<div class="page-header">
    <div>
        <h1>สต็อกสินค้า</h1>
        <p class="subtitle">ยอดคงเหลือปัจจุบัน (1 รุ่นต่อ 1 แถว พร้อมรายละเอียดสีในแถวเดียว)</p>
    </div>
    <div class="page-actions">
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
        {
            <button type="button" class="btn btn-success open-txn-modal">
                <i class="bi bi-plus-circle me-1"></i>บันทึกรายการ
            </button>
            <a asp-controller="Products" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-box-seam me-1"></i>เพิ่มสินค้าใหม่
            </a>
        }
        <a asp-action="MonthlyReport" class="btn btn-outline-primary">
            <i class="bi bi-bar-chart-line me-1"></i>รายงาน
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">จำนวนรุ่นสินค้า</div>
                    <div class="stat-value">@Model.TotalItems.ToString("N0")</div>
                    <div class="stat-sub">@Model.TotalVariants สี/รุ่นทั้งหมด</div>
                </div>
                <div class="stat-icon"><i class="bi bi-grid-3x3-gap"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">สต็อกรวม</div>
                    <div class="stat-value">@Model.TotalPieces.ToString("N0")</div>
                    <div class="stat-sub">@Model.TotalCases.ToString("N0") ลัง</div>
                </div>
                <div class="stat-icon"><i class="bi bi-box-seam"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div id="lowStockCard"
             class="stat-card stat-clickable @(Model.LowStockCount > 0 ? "stat-warning" : "stat-secondary")"
             role="button" title="คลิกเพื่อดูรายการ">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">สินค้าใกล้หมด</div>
                    <div class="stat-value">@Model.LowStockCount</div>
                    <div class="stat-sub">เหลือ ≤ 10 ชิ้น</div>
                </div>
                <div class="stat-icon"><i class="bi bi-exclamation-triangle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div id="outOfStockCard"
             class="stat-card stat-clickable @(Model.OutOfStockCount > 0 ? "stat-danger" : "stat-secondary")"
             role="button" title="คลิกเพื่อดูรายการ">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">หมดสต็อก</div>
                    <div class="stat-value">@Model.OutOfStockCount</div>
                    <div class="stat-sub">รุ่นที่ไม่มีสต็อก</div>
                </div>
                <div class="stat-icon"><i class="bi bi-x-circle"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="filter-bar">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">หมวดหมู่</label>
            <select name="category" class="form-select">
                <option value="">ทุกหมวดหมู่</option>
                @foreach (var cat in Model.Categories)
                {
                    if (Model.CategoryFilter == cat)
                    {
                        <option value="@cat" selected>@cat</option>
                    }
                    else
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label">ค้นหา</label>
            <input type="text" name="search" value="@Model.Search" class="form-control"
                   placeholder="SKU, ชื่อสินค้า, สี/รุ่น" />
        </div>
        <div class="col-md-4">
            <label class="form-label">ต่อหน้า</label>
            <select name="pageSize" class="form-select d-inline-block w-auto me-2">
                @if (Model.PageSize == 10)
                {
                    <option value="10" selected>10</option>
                }
                else
                {
                    <option value="10">10</option>
                }
                @if (Model.PageSize == 20)
                {
                    <option value="20" selected>20</option>
                }
                else
                {
                    <option value="20">20</option>
                }
                @if (Model.PageSize == 50)
                {
                    <option value="50" selected>50</option>
                }
                else
                {
                    <option value="50">50</option>
                }
            </select>
            <input type="hidden" name="page" value="1" />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search me-1"></i>ค้นหา
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">ล้าง</a>
        </div>
    </form>
</div>

@if (!Model.Items.Any())
{
    <div class="card-app">
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-inbox"></i></div>
            <p class="mb-0">ไม่พบสินค้า</p>
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>หมวดหมู่</th>
                        <th>SKU</th>
                        <th>ชื่อสินค้า</th>
                        <th>สี/รุ่น</th>
                        <th class="text-end">ชิ้น</th>
                        <th class="text-end">ลัง</th>
                        <th>หน่วย</th>
                        <th>อัปเดตล่าสุด</th>
                        <th class="text-end">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var isEmpty = item.QtyPieces == 0 && item.QtyCases == 0;
                        <tr class="@(isEmpty ? "row-empty" : "")">
                            <td><span class="text-muted small">@item.CategoryName</span></td>
                            <td><code>@item.Sku</code></td>
                            <td class="fw-medium">@item.ProductName</td>
                            <td>
                                @if (item.Colors.Any())
                                {
                                    <div class="color-swatch-grid">
                                        @foreach (var color in item.Colors)
                                        {
                                            var colorEmpty = color.QtyPieces == 0;
                                            <span class="color-swatch @(colorEmpty ? "color-swatch--empty" : "")"
                                                  data-vname="@color.VariantName"
                                                  title="@color.VariantName — @(colorEmpty ? "หมด" : color.QtyPieces.ToString("N0") + " ชิ้น")">
                                                <span class="color-swatch__fill">@(colorEmpty ? "" : color.QtyPieces.ToString("N0"))</span>
                                                <span class="color-swatch__label">@color.VariantName</span>
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">@item.QtyPieces.ToString("N0")</td>
                            <td class="text-end fw-semibold">@item.QtyCases.ToString("N0")</td>
                            <td><span class="badge bg-light text-dark border">@item.Unit</span></td>
                            <td class="text-muted small">
                                @if (item.LastUpdated.HasValue)
                                {
                                    @item.LastUpdated.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                                {
                                    if (item.PrimaryVariantId.HasValue)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success open-txn-modal"
                                                data-variant-id="@item.PrimaryVariantId.Value">
                                            <i class="bi bi-plus-circle me-1"></i>บันทึกรายการ
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success open-txn-modal"
                                                data-product-id="@item.ProductId">
                                            <i class="bi bi-plus-circle me-1"></i>บันทึกรายการ
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="small text-muted">
            ทั้งหมด @Model.TotalItems รายการ | หน้า @Model.Page / @Model.TotalPages
        </div>
        <nav aria-label="pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-category="@Model.CategoryFilter"
                       asp-route-search="@Model.Search"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-page="@(Model.Page - 1)">ก่อนหน้า</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@Model.Page / @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-category="@Model.CategoryFilter"
                       asp-route-search="@Model.Search"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-page="@(Model.Page + 1)">ถัดไป</a>
                </li>
            </ul>
        </nav>
    </div>
}

<div class="modal fade" id="alertModal" tabindex="-1" aria-labelledby="alertModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title" id="alertModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2" id="alertModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createTxnModal" tabindex="-1" aria-labelledby="createTxnModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title" id="createTxnModalLabel">
                    <i class="bi bi-plus-circle text-success me-2"></i>บันทึกรายการสต็อก
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="createTxnModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="text-muted small mt-2">กำลังโหลด...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    /* ── shared color palette ─────────────────────────────────── */
    const palette = [
        { keys: ['ดำ'],                          bg: '#1e293b', text: '#f8fafc', dot: '#94a3b8' },
        { keys: ['แดง'],                         bg: '#fee2e2', text: '#991b1b', dot: '#ef4444' },
        { keys: ['น้ำเงิน'],                     bg: '#dbeafe', text: '#1e40af', dot: '#3b82f6' },
        { keys: ['ฟ้า','ธงฟ้า'],                bg: '#e0f2fe', text: '#0369a1', dot: '#0ea5e9' },
        { keys: ['ส้ม'],                         bg: '#ffedd5', text: '#9a3412', dot: '#f97316' },
        { keys: ['เขียวออ่อน','เขียวอ่อน'],     bg: '#dcfce7', text: '#166534', dot: '#4ade80' },
        { keys: ['เขียว'],                       bg: '#d1fae5', text: '#065f46', dot: '#10b981' },
        { keys: ['ชมพูอ่อน'],                    bg: '#fdf2f8', text: '#9d174d', dot: '#f9a8d4' },
        { keys: ['ชมพูเข้ม','ชมพู','ชม'],       bg: '#fce7f3', text: '#9d174d', dot: '#ec4899' },
        { keys: ['ทอง'],                         bg: '#fef3c7', text: '#78350f', dot: '#f59e0b' },
        { keys: ['เหลือง','ครีม'],               bg: '#fef9c3', text: '#713f12', dot: '#eab308' },
        { keys: ['ม่วง'],                        bg: '#ede9fe', text: '#4c1d95', dot: '#8b5cf6' },
        { keys: ['น้ำตาล'],                      bg: '#fef3c7', text: '#92400e', dot: '#b45309' },
        { keys: ['เทา'],                         bg: '#f1f5f9', text: '#475569', dot: '#94a3b8' },
        { keys: ['ขาว'],                         bg: '#f8fafc', text: '#334155', dot: '#cbd5e1' },
        { keys: ['วัว'],                         bg: '#fef2f2', text: '#7f1d1d', dot: '#fca5a5' },
    ];
    function resolveColor(name) {
        for (const e of palette) { if (e.keys.some(k => name.includes(k))) return e; }
        return { bg: '#f4f4f5', text: '#52525b', dot: '#94a3b8' };
    }

    /* ── apply color chips in stock table ─────────────────────── */
    document.querySelectorAll('.color-chip[data-vname]').forEach(chip => {
        const col = resolveColor(chip.dataset.vname || '');
        if (!col) return;
        chip.style.setProperty('--chip-bg',   col.bg);
        chip.style.setProperty('--chip-text', col.text);
        chip.style.setProperty('--chip-dot',  col.dot);
    });

    /* ── apply colors to Excel-style swatches ─────────────────── */
    document.querySelectorAll('.color-swatch[data-vname]').forEach(swatch => {
        const col = resolveColor(swatch.dataset.vname || '');
        swatch.style.setProperty('--swatch-color', col.dot);
    });

    /* ── modal: initialize form after AJAX load ───────────────── */
    function initModalForm() {
        const productSelect = document.getElementById('productSelect');
        const productSearch = document.getElementById('productSearch');
        const variantChips  = document.getElementById('variantChips');
        const variantHidden = document.getElementById('variantHidden');
        const variantDataEl = document.getElementById('variantData');
        const form          = document.getElementById('createTxnForm');
        const qtyPiecesInput = form?.querySelector('[name="QtyPieces"]');
        const qtyCasesInput  = form?.querySelector('[name="QtyCases"]');
        const addLineBtn     = document.getElementById('addTxnLineBtn');
        const linesWrap      = document.getElementById('txnLinesWrap');
        const linesBody      = document.getElementById('txnLinesBody');
        const linesInputs    = document.getElementById('txnLinesInputs');
        if (!productSelect || !productSearch || !variantChips || !variantHidden || !variantDataEl ||
            !form || !qtyPiecesInput || !qtyCasesInput || !addLineBtn || !linesWrap || !linesBody || !linesInputs) return;

        const allVariants = Array.from(variantDataEl.querySelectorAll('[data-variant-id]'))
            .map(el => ({
                variantId: el.dataset.variantId,
                productId: el.dataset.productId,
                sku: el.dataset.sku,
                label: el.dataset.label
            }));

        const initialVariantId = variantHidden.value;
        const txnLines = [];

        const productOptions = Array.from(productSelect.options).map(option => ({
            option,
            value: option.value,
            text: option.textContent.toLowerCase(),
        }));

        function filterProducts(query) {
            const term = query.trim().toLowerCase();
            productOptions.forEach(({ option, value, text }) => {
                option.hidden = !!value && !!term && !text.includes(term);
            });
        }

        function buildChips(productId) {
            const filtered = allVariants.filter(v => v.productId === productId);
            variantChips.innerHTML = '';
            if (!filtered.length) {
                variantChips.innerHTML = productId
                    ? '<span class="text-muted small fst-italic">ไม่พบสี/รุ่น</span>'
                    : '<span class="text-muted small fst-italic">เลือกสินค้าก่อน</span>';
                return;
            }
            filtered.forEach(v => {
                const col = resolveColor(v.label);
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'variant-chip-btn';
                btn.dataset.variantId = v.variantId;
                btn.style.setProperty('--chip-bg',   col.bg);
                btn.style.setProperty('--chip-text', col.text);
                btn.style.setProperty('--chip-dot',  col.dot);
                if (v.variantId === initialVariantId) btn.classList.add('is-selected');
                btn.innerHTML = `
                    <code class="variant-chip-btn__sku">${v.sku}</code>
                    <span class="color-swatch color-swatch--variant-choice" title="${v.label}">
                        <span class="color-swatch__fill"></span>
                        <span class="color-swatch__label">${v.label}</span>
                    </span>`;
                btn.addEventListener('click', () => selectVariant(btn, v.variantId));
                variantChips.appendChild(btn);
            });
        }

        function selectVariant(btn, id) {
            variantChips.querySelectorAll('.variant-chip-btn').forEach(b => b.classList.remove('is-selected'));
            btn.classList.add('is-selected');
            variantHidden.value = id;
        }

        function readQty(input) {
            const value = Number.parseInt(input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : 0;
        }

        function renderTxnLines() {
            linesWrap.classList.toggle('d-none', txnLines.length === 0);
            linesBody.innerHTML = '';
            linesInputs.innerHTML = '';

            txnLines.forEach((line, index) => {
                const col = resolveColor(line.label);
                linesBody.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td><code>${line.sku}</code></td>
                        <td>
                            <span class="color-swatch color-swatch--txn-line" style="--swatch-color:${col.dot}" title="${line.label}">
                                <span class="color-swatch__fill">${line.qtyPieces ? line.qtyPieces.toLocaleString() : ''}</span>
                                <span class="color-swatch__label">${line.label}</span>
                            </span>
                        </td>
                        <td class="text-end">${line.qtyPieces.toLocaleString()}</td>
                        <td class="text-end">${line.qtyCases.toLocaleString()}</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-txn-line" data-index="${index}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>`);

                linesInputs.insertAdjacentHTML('beforeend', `
                    <input type="hidden" name="Lines[${index}].VariantId" value="${line.variantId}" />
                    <input type="hidden" name="Lines[${index}].QtyPieces" value="${line.qtyPieces}" />
                    <input type="hidden" name="Lines[${index}].QtyCases" value="${line.qtyCases}" />`);
            });
        }

        function addCurrentLine(showAlert = true) {
            const variantId = variantHidden.value;
            const qtyPieces = readQty(qtyPiecesInput);
            const qtyCases = readQty(qtyCasesInput);
            const variant = allVariants.find(v => v.variantId === variantId);

            if (!variantId || !variant) {
                if (showAlert) alert('กรุณาเลือกสี/รุ่นก่อนเพิ่มรายการ');
                return false;
            }

            if (qtyPieces === 0 && qtyCases === 0) {
                if (showAlert) alert('กรุณาระบุจำนวนชิ้นหรือลังอย่างน้อย 1 รายการ');
                return false;
            }

            const existing = txnLines.find(line => line.variantId === variantId);
            if (existing) {
                existing.qtyPieces += qtyPieces;
                existing.qtyCases += qtyCases;
            } else {
                txnLines.push({
                    variantId,
                    sku: variant.sku,
                    label: variant.label,
                    qtyPieces,
                    qtyCases
                });
            }

            qtyPiecesInput.value = 0;
            qtyCasesInput.value = 0;
            renderTxnLines();
            return true;
        }

        productSelect.addEventListener('change', () => {
            variantHidden.value = '';
            buildChips(productSelect.value);
        });
        productSearch.addEventListener('input', () => filterProducts(productSearch.value));
        addLineBtn.addEventListener('click', () => addCurrentLine());
        linesBody.addEventListener('click', (e) => {
            const removeBtn = e.target.closest('.remove-txn-line');
            if (!removeBtn) return;

            txnLines.splice(Number.parseInt(removeBtn.dataset.index, 10), 1);
            renderTxnLines();
        });
        if (productSelect.value) buildChips(productSelect.value);

        /* pill radio toggle */
        document.querySelectorAll('.txn-type-pill input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.txn-type-pill').forEach(p => p.classList.remove('is-checked'));
                if (radio.checked) radio.closest('.txn-type-pill').classList.add('is-checked');
            });
        });

        /* AJAX form submit */
        const alertDiv  = document.getElementById('modalAlert');
        const submitBtn = document.getElementById('modalSubmitBtn');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (txnLines.length === 0) {
                const hasDraftQty = readQty(qtyPiecesInput) > 0 || readQty(qtyCasesInput) > 0;
                if (hasDraftQty) addCurrentLine(false);
            }
            alertDiv.classList.add('d-none');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>กำลังบันทึก...';

            try {
                const res = await fetch('@Url.Action("Create", "Transactions")', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form)
                });

                if (res.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('createTxnModal')).hide();
                    showToast('บันทึกรายการสต็อกสำเร็จ', 'success');
                    setTimeout(() => location.reload(), 900);
                } else {
                    const data = await res.json().catch(() => ({}));
                    alertDiv.textContent = data.message || 'เกิดข้อผิดพลาด กรุณาลองใหม่';
                    alertDiv.classList.remove('d-none');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i>บันทึก';
                }
            } catch {
                alertDiv.textContent = 'เกิดข้อผิดพลาดในการเชื่อมต่อ';
                alertDiv.classList.remove('d-none');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i>บันทึก';
            }
        });
    }

    /* ── toast notification ───────────────────────────────────── */
    function showToast(msg, type) {
        const el = document.createElement('div');
        el.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show shadow-sm`;
        el.style.cssText = 'position:fixed;top:1.25rem;left:50%;transform:translateX(-50%);z-index:9999;min-width:260px;text-align:center';
        el.innerHTML = `<i class="bi bi-check-circle me-1"></i>${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 4000);
    }

    /* ── open-modal buttons ───────────────────────────────────── */
    document.querySelectorAll('.open-txn-modal').forEach(btn => {
        btn.addEventListener('click', async () => {
            const variantId = btn.dataset.variantId;
            const productId = btn.dataset.productId;
            const params = new URLSearchParams();
            if (variantId) params.set('variantId', variantId);
            if (productId) params.set('productId', productId);
            const query = params.toString();
            const url = '@Url.Action("CreateModal", "Transactions")' + (query ? `?${query}` : '');

            const modalEl   = document.getElementById('createTxnModal');
            const modalBody = document.getElementById('createTxnModalBody');

            modalBody.innerHTML =
                '<div class="text-center py-5"><div class="spinner-border text-primary"></div>' +
                '<p class="text-muted small mt-2">กำลังโหลด...</p></div>';

            bootstrap.Modal.getOrCreateInstance(modalEl).show();

            try {
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (res.ok) {
                    modalBody.innerHTML = await res.text();
                    initModalForm();
                } else {
                    modalBody.innerHTML = '<div class="alert alert-danger m-2">โหลดฟอร์มไม่สำเร็จ กรุณาลองใหม่</div>';
                }
            } catch {
                modalBody.innerHTML = '<div class="alert alert-danger m-2">เกิดข้อผิดพลาดในการเชื่อมต่อ</div>';
            }
        });
    });

    /* ── alert modal (ใกล้หมด / หมดสต็อก) ───────────────────── */
    function chipHtml(variantName, qtyPieces) {
        const col   = resolveColor(variantName);
        const empty = qtyPieces === 0;
        return `<span class="color-swatch color-swatch--table ${empty ? 'color-swatch--empty' : ''}"
                      style="--swatch-color:${col.dot}" title="${variantName} — ${empty ? 'หมด' : qtyPieces.toLocaleString() + ' ชิ้น'}">
                    <span class="color-swatch__fill">${empty ? '' : qtyPieces.toLocaleString()}</span>
                    <span class="color-swatch__label">${variantName}</span>
                </span>`;
    }

    async function openAlertModal(alertType) {
        const isOut = alertType === 'out';
        const icon  = isOut ? 'bi-x-circle text-danger' : 'bi-exclamation-triangle text-warning';
        const title = isOut ? 'สินค้าหมดสต็อก' : 'สินค้าใกล้หมด (≤ 10 ชิ้น)';

        document.getElementById('alertModalTitle').innerHTML =
            `<i class="bi ${icon} me-2"></i>${title}`;
        document.getElementById('alertModalBody').innerHTML =
            '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';

        bootstrap.Modal.getOrCreateInstance(document.getElementById('alertModal')).show();

        try {
            const res   = await fetch(`@Url.Action("AlertItems", "Stock")?alertType=${alertType}`);
            const items = await res.json();

            if (!items.length) {
                document.getElementById('alertModalBody').innerHTML =
                    '<p class="text-muted text-center py-4"><i class="bi bi-check-circle me-1 text-success"></i>ไม่มีรายการ</p>';
                return;
            }

            const colorCol = !isOut;
            let html = `<div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="text-muted small fw-normal">หมวดหมู่</th>
                            <th class="text-muted small fw-normal">SKU</th>
                            <th class="text-muted small fw-normal">ชื่อสินค้า</th>
                            ${colorCol ? '<th class="text-muted small fw-normal">สี/รุ่น</th>' : ''}
                            <th class="text-end text-muted small fw-normal">ชิ้นรวม</th>
                        </tr>
                    </thead>
                    <tbody>`;

            for (const item of items) {
                const pcsClass = item.qtyPieces === 0 ? 'text-danger fw-bold' : 'text-warning fw-bold';
                let colorCell = '';
                if (colorCol) {
                    const activeColors = item.colors.filter(c => c.qtyPieces > 0);
                    colorCell = `<td>${activeColors.length
                        ? `<div class="color-swatch-grid">${activeColors.map(c => chipHtml(c.variantName, c.qtyPieces)).join(' ')}</div>`
                        : '<span class="text-muted small fst-italic">-</span>'}</td>`;
                }
                html += `<tr>
                    <td><span class="text-muted small">${item.categoryName}</span></td>
                    <td><code>${item.sku}</code></td>
                    <td class="fw-medium">${item.productName}</td>
                    ${colorCell}
                    <td class="text-end ${pcsClass}">${item.qtyPieces.toLocaleString()}</td>
                </tr>`;
            }

            html += '</tbody></table></div>';
            document.getElementById('alertModalBody').innerHTML = html;
        } catch {
            document.getElementById('alertModalBody').innerHTML =
                '<div class="alert alert-danger m-2">โหลดข้อมูลไม่สำเร็จ กรุณาลองใหม่</div>';
        }
    }

    document.getElementById('lowStockCard')  ?.addEventListener('click', () => openAlertModal('low'));
    document.getElementById('outOfStockCard')?.addEventListener('click', () => openAlertModal('out'));
})();
</script>
}
