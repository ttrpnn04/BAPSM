@model BAPStockManagement.ViewModels.Customers.CustomerImportViewModel
@{
    ViewData["Title"] = "นำเข้าลูกค้าจาก Excel";
}

<div class="page-header">
    <div>
        <h1>นำเข้าลูกค้าจาก Excel</h1>
        <p class="subtitle">อ่านชีต customer หรือ customer_BAP จากไฟล์บิลขาย / ใบปะ</p>
    </div>
</div>

<form asp-action="Import" method="post" enctype="multipart/form-data" class="col-lg-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="File" class="form-label"></label>
        <input asp-for="File" type="file" class="form-control" accept=".xlsx,.xlsm" />
        <div class="form-text">ระบบจะอัปเดตตามรหัสลูกค้า ถ้ามีอยู่แล้วจะเขียนทับข้อมูล</div>
        <span asp-validation-for="File" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">นำเข้า</button>
    <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
