@model BAPStockManagement.ViewModels.Customers.CustomerFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <label asp-for="CustomerCode" class="form-label"></label>
        <input asp-for="CustomerCode" class="form-control" />
        <span asp-validation-for="CustomerCode" class="text-danger"></span>
    </div>
    <div class="col-md-9">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="District" class="form-label"></label>
        <input asp-for="District" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Province" class="form-label"></label>
        <input asp-for="Province" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="SalesZone" class="form-label"></label>
        <input asp-for="SalesZone" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Phone1" class="form-label"></label>
        <input asp-for="Phone1" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Phone2" class="form-label"></label>
        <input asp-for="Phone2" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="TaxId" class="form-label"></label>
        <input asp-for="TaxId" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="ShippingInfo" class="form-label"></label>
        <textarea asp-for="ShippingInfo" class="form-control" rows="2"></textarea>
    </div>
    <div class="col-md-4">
        <label asp-for="CreditLimit" class="form-label"></label>
        <input asp-for="CreditLimit" class="form-control" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
</div>
