@model BAPStockManagement.ViewModels.Customers.CustomerFormViewModel
@{
    ViewData["Title"] = "เพิ่มลูกค้า";
}

<div class="page-header">
    <div>
        <h1>เพิ่มลูกค้า</h1>
        <p class="subtitle">กรอกข้อมูลร้านสำหรับออกบิล</p>
    </div>
</div>

<form asp-action="Create" method="post" class="col-lg-8">
    <partial name="_CustomerForm" />
    <button type="submit" class="btn btn-primary">บันทึก</button>
    <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
