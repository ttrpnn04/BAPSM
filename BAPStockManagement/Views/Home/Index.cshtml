@{
    ViewData["Title"] = "หน้าแรก";
    var canEdit = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
    var isAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
    var name = User.Identity?.Name?.Split('@')[0] ?? "ผู้ใช้";
}

<div class="greeting-bar">
    <h1>สวัสดี, @name 👋</h1>
    <p>ยินดีต้อนรับสู่ระบบจัดการสต็อกสินค้า BAP Stock</p>
</div>

<div class="row g-3">
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Stock" asp-action="Index" class="quick-link-card ql-primary">
            <div class="ql-icon"><i class="bi bi-box-seam"></i></div>
            <div class="ql-title">สต็อกสินค้า</div>
            <p class="ql-desc">ตรวจสอบยอดคงเหลือแยกตามสี/รุ่น</p>
        </a>
    </div>

    @if (canEdit)
    {
        <div class="col-sm-6 col-xl-4">
            <a asp-controller="Transactions" asp-action="Create" class="quick-link-card ql-success">
                <div class="ql-icon"><i class="bi bi-plus-circle"></i></div>
                <div class="ql-title">บันทึกรายการ</div>
                <p class="ql-desc">รับเข้า หรือ จ่ายออกสต็อกสินค้า</p>
            </a>
        </div>
    }

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Transactions" asp-action="Index" class="quick-link-card ql-info">
            <div class="ql-icon"><i class="bi bi-arrow-left-right"></i></div>
            <div class="ql-title">ประวัติรายการ</div>
            <p class="ql-desc">ดูการเคลื่อนไหวสต็อกย้อนหลัง</p>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Stock" asp-action="MonthlyReport" class="quick-link-card ql-secondary">
            <div class="ql-icon"><i class="bi bi-bar-chart-line"></i></div>
            <div class="ql-title">รายงานรายเดือน</div>
            <p class="ql-desc">สรุปรับเข้า จ่ายออก และยอดสุทธิ</p>
        </a>
    </div>

    @if (isAdmin)
    {
        <div class="col-sm-6 col-xl-4">
            <a asp-controller="Categories" asp-action="Index" class="quick-link-card ql-secondary">
                <div class="ql-icon"><i class="bi bi-folder2"></i></div>
                <div class="ql-title">หมวดหมู่</div>
                <p class="ql-desc">จัดการหมวดหมู่สินค้า</p>
            </a>
        </div>
        <div class="col-sm-6 col-xl-4">
            <a asp-controller="Import" asp-action="Index" class="quick-link-card ql-secondary">
                <div class="ql-icon"><i class="bi bi-file-earmark-arrow-up"></i></div>
                <div class="ql-title">Import Excel</div>
                <p class="ql-desc">นำเข้าข้อมูลจริงจากไฟล์ .xlsx</p>
            </a>
        </div>
        <div class="col-sm-6 col-xl-4">
            <a asp-controller="Export" asp-action="Index" class="quick-link-card ql-secondary">
                <div class="ql-icon"><i class="bi bi-file-earmark-arrow-down"></i></div>
                <div class="ql-title">Export Excel</div>
                <p class="ql-desc">ส่งออกรายงานเข้า ออก และสต็อกรวม</p>
            </a>
        </div>
    }

    @if (User.IsInRole("SuperAdmin"))
    {
        <div class="col-sm-6 col-xl-4">
            <a asp-controller="Users" asp-action="Index" class="quick-link-card ql-secondary">
                <div class="ql-icon"><i class="bi bi-people"></i></div>
                <div class="ql-title">ผู้ใช้งาน</div>
                <p class="ql-desc">สร้างและกำหนดสิทธิ์ผู้ใช้</p>
            </a>
        </div>
    }
</div>
