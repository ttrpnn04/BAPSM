@model BAPStockManagement.ViewModels.Products.CreateProductViewModel

<form id="createProductForm" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">-- เลือกหมวดหมู่ --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-5">
            <label asp-for="Sku" class="form-label"></label>
            <input asp-for="Sku" class="form-control" />
            <span asp-validation-for="Sku" class="text-danger"></span>
        </div>
        <div class="col-md-7">
            <label asp-for="ProductName" class="form-label"></label>
            <input asp-for="ProductName" class="form-control" />
            <span asp-validation-for="ProductName" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mt-0">
        <div class="col-md-4">
            <label asp-for="Unit" class="form-label"></label>
            <input asp-for="Unit" class="form-control" />
            <span asp-validation-for="Unit" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Note" class="form-label"></label>
            <input asp-for="Note" class="form-control" />
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3 mb-4">
        <label asp-for="VariantsText" class="form-label"></label>
        <textarea asp-for="VariantsText" class="form-control" rows="5"
                  placeholder="เช่น&#10;แดง&#10;น้ำเงิน/ชม&#10;ฟ้า"></textarea>
        <div class="form-text">ใส่สี/รุ่นได้หลายรายการ คั่นด้วย Enter, จุลภาค หรือเซมิโคลอน</div>
        <span asp-validation-for="VariantsText" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2 justify-content-end">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
        <button type="submit" class="btn btn-primary" id="productModalSubmitBtn">
            <i class="bi bi-check-lg me-1"></i>บันทึก
        </button>
    </div>
</form>
