@model IEnumerable<BAPStockManagement.ViewModels.Products.ProductListItemViewModel>
@{
    ViewData["Title"] = "จัดการสินค้า";
    var categories = ViewBag.Categories as IReadOnlyList<string> ?? [];
    var categoryFilter = ViewBag.CategoryFilter as string;
    var search = ViewBag.Search as string;
    var showInactive = ViewBag.ShowInactive as bool? ?? false;
}

<div class="page-header">
    <div>
        <h1>จัดการสินค้า</h1>
        <p class="subtitle">SKU, ชื่อสินค้า และสี/รุ่น</p>
    </div>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>เพิ่มสินค้า
            </a>
        </div>
    }
</div>

<div class="filter-bar">
<form asp-action="Index" method="get" class="row g-2 align-items-end">
    <div class="col-md-3">
        <label class="form-label">หมวดหมู่</label>
        <select name="category" class="form-select">
            <option value="">ทุกหมวดหมู่</option>
            @foreach (var cat in categories)
            {
                if (categoryFilter == cat)
                {
                    <option value="@cat" selected>@cat</option>
                }
                else
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">ค้นหา</label>
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="ค้นหา SKU, ชื่อสินค้า" />
    </div>
    <div class="col-md-2">
        <div class="form-check mb-2">
            <input type="checkbox" name="showInactive" value="true" class="form-check-input"
                   id="showInactive" @(showInactive ? "checked" : "") />
            <label class="form-check-label" for="showInactive">แสดงที่ปิดใช้งาน</label>
        </div>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>ค้นหา</button>
        <a asp-action="Index" class="btn btn-outline-secondary">ล้าง</a>
    </div>
</form>
</div>

@if (!Model.Any())
{
    <div class="card-app">
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-tag"></i></div>
            <p class="mb-0">ไม่พบสินค้า</p>
        </div>
    </div>
}
else
{
    <div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>หมวดหมู่</th>
                    <th>SKU</th>
                    <th>ชื่อสินค้า</th>
                    <th>หน่วย</th>
                    <th class="text-end">สี/รุ่น</th>
                    <th class="text-end">ชิ้น</th>
                    <th class="text-end">ลัง</th>
                    <th>สถานะ</th>
                    <th class="text-end">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(!item.IsActive ? "table-secondary" : "")">
                        <td><span class="text-muted small">@item.CategoryName</span></td>
                        <td><code>@item.Sku</code></td>
                        <td class="fw-medium">@item.ProductName</td>
                        <td>@item.Unit</td>
                        <td class="text-end">@item.VariantCount</td>
                        <td class="text-end">@item.TotalPieces.ToString("N0")</td>
                        <td class="text-end">@item.TotalCases.ToString("N0")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">ใช้งาน</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">ปิด</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            }
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Staff"))
                            {
                                <a asp-controller="Transactions" asp-action="Create" class="btn btn-sm btn-outline-success"><i class="bi bi-plus-lg"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
}
